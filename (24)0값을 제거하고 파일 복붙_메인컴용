        # 1.79e+308 값을 제외한 나머지 값이 0인지 확인
        valid_values = raster.values[raster.values != 1.79e+308]  # 1.79e+308 값 제외
        if np.all(valid_values == 0):  # 남은 값이 모두 0인지 확인
